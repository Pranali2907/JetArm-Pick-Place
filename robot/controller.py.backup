"""ROS 2 adapter around the unmodified Hiwonder company pick/place functions."""
import threading
import time

import rclpy
from rclpy.executors import MultiThreadedExecutor
from kinematics_msgs.srv import SetRobotPose
from servo_controller_msgs.msg import ServosPosition

from kinematics.kinematics_control import set_pose_target
from servo_controller.bus_servo_control import set_servo_position
from app.utils import pick_and_place


class JetArmController:
    def __init__(self, node_name="jetarm_fruit_controller"):
        if not rclpy.ok():
            raise RuntimeError("ROS 2 is not initialized. Initialize rclpy before creating JetArmController.")
        self.node = rclpy.create_node(node_name)
        self.joints_pub = self.node.create_publisher(ServosPosition, "servo_controller", 1)
        self.kinematics_client = self.node.create_client(SetRobotPose, "kinematics/set_pose_target")
        self.executor = MultiThreadedExecutor(num_threads=2)
        self.executor.add_node(self.node)
        self.spin_thread = threading.Thread(target=self.executor.spin, name="jetarm-ros-executor", daemon=True)
        self.spin_thread.start()
        self.closed = False
        if not self.kinematics_client.wait_for_service(timeout_sec=8.0):
            self.close()
            raise TimeoutError("/kinematics/set_pose_target is not available")

    def _call_ik(self, position, pitch=80.0, timeout=5.0):
        request = SetRobotPose.Request()
        request.position = [float(v) for v in position]
        request.pitch = float(pitch)
        request.pitch_range = [-90.0, 90.0]
        request.resolution = 1.0
        request.duration = 1.0
        future = self.kinematics_client.call_async(request)
        event = threading.Event()
        future.add_done_callback(lambda _future: event.set())
        if not event.wait(timeout):
            raise TimeoutError(f"IK request timed out for position {position}")
        result = future.result()
        if result is None:
            raise RuntimeError(f"IK service returned no response for {position}")
        # The company service may set success=True even if no solution exists.
        if not result.pulse:
            raise ValueError(f"No IK pulse solution for position {position}; service success={result.success}")
        return result

    def check_pose(self, position, pitch=80.0):
        """IK-only check; set_pose_target service does not publish servo commands."""
        result = self._call_ik(position, pitch)
        return {"position": list(map(float, position)), "pulse_count": len(result.pulse), "pulses": list(result.pulse)}

    def preflight_pick(self, position, pitch=80.0, gripper_depth=0.02):
        p = list(map(float, position))
        # These are the three Cartesian targets reached by the company pick().
        targets = [p.copy(), p.copy(), p.copy()]
        targets[0][2] += 0.01
        targets[1][2] -= float(gripper_depth)
        targets[2][2] += 0.02
        for target in targets:
            self.check_pose(target, pitch)
        return True

    def preflight_place(self, position, pitch=80.0):
        p = list(map(float, position))
        for dz in (0.03, 0.0, 0.03):
            target = p.copy()
            target[2] += dz
            self.check_pose(target, pitch)
        return True

    def pick(self, position, yaw=500, pitch=80, gripper_angle=540, gripper_depth=0.02):
        # Company functions mutate their input list; always pass a copy.
        pick_and_place.interrupt(False)
        result = pick_and_place.pick(list(map(float, position)), pitch, int(yaw), int(gripper_angle), float(gripper_depth), self.joints_pub, self.kinematics_client)
        if not result:
            raise RuntimeError("Company pick() returned False (interrupted or pickup failed)")
        return True

    def place(self, position, yaw=500, pitch=80, gripper_angle=200):
        result = pick_and_place.place(list(map(float, position)), pitch, int(yaw), int(gripper_angle), self.joints_pub, self.kinematics_client)
        if not result:
            raise RuntimeError("Company place() returned False (interrupted or placement failed)")
        return True

    def request_stop(self):
        # Company's stop flag is checked between motion segments; this is not an emergency stop.
        pick_and_place.interrupt(True)

    def close(self):
        if self.closed:
            return
        self.closed = True
        try:
            pick_and_place.interrupt(True)
        except Exception:
            pass
        try:
            self.executor.shutdown(timeout_sec=2.0)
        except Exception:
            pass
        try:
            self.node.destroy_node()
        except Exception:
            pass
